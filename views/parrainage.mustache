{{> partials/en_tete}}
<main>
    <h1>Mon Parrainage</h1>

    {{#est_parrain}}
    <section>
        <h2>Mes Filleuls</h2>
        <p>Voici les étudiants que vous accompagnez cette année :</p>
        <ul class="liste-filleuls">
            {{#filleuls}}
            <li>{{nom_utilisateur}}</li>
            {{/filleuls}}
            {{^filleuls}}
            <p>Vous n'avez pas encore de filleuls attribués.</p>
            {{/filleuls}}
        </ul>
    </section>
    {{/est_parrain}}

    {{^est_parrain}}
    <section>
        <h2>Mon Parrain</h2>
        {{#parrain}}
        <div class="carte-parrain">
            <p>Votre parrain est : <strong>{{nom_utilisateur}}</strong></p>
            <p>N'hésitez pas à le contacter pour toute question académique !</p>
        </div>
        {{/parrain}}

        {{^parrain}}
        <div class="demande-parrain">
            <p>Vous n'avez pas encore de parrain.</p>
            <form action="/demander-parrain" method="POST">
                <button type="submit" class="btn-principal">Demander un parrain</button>
            </form>
        </div>
        {{/parrain}}
    </section>
    {{/est_parrain}}
</main>
{{> partials/pied_de_page}}