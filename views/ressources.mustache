{{> partials/en_tete}}
<main>
    <h1>Ressources Pédagogiques</h1>
    <p>Retrouvez ici les fiches de révision et documents partagés par la communauté.</p>

    <table class="table-ressources">
        <thead>
            <tr>
                <th>Matière</th>
                <th>Titre du document</th>
                <th>Partagé par</th>
                <th>Lien</th>
            </tr>
        </thead>
        <tbody>
            {{#ressources}}
            <tr>
                <td><span class="tag">{{matiere}}</span></td>
                <td><strong>{{titre}}</strong></td>
                <td>{{nom_utilisateur}}</td>
                <td><a href="{{lien_url}}" target="_blank" class="btn-download">Consulter</a></td>
            </tr>
            {{/ressources}}
        </tbody>
    </table>

    <div class="actions">
        <a href="/ajouter-ressource" class="btn-principal">Partager un document</a>
    </div>
</main>
{{> partials/pied_de_page}}